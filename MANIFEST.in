include README.md CONTRIBUTING.md SECURITY.md LICENSE NOTICE THIRD_PARTY_NOTICES.md
include requirements.txt requirements.lock run_studio.py
include *.command
recursive-include docs *.md
recursive-include scripts *.py
recursive-include packaging *.py *.spec *.txt
recursive-include tests *.py *.cjs
recursive-include studio/templates *.html
recursive-include studio/static *.js *.css *.svg
prune instance
prune .venv
prune .venv-release
global-exclude __pycache__ *.py[cod] .DS_Store
